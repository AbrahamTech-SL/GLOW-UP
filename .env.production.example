# GLOW UP — PRODUCTION ENVIRONMENT CONFIGURATION
# Set these environment variables in your production hosting provider (Vercel, Netlify, Cloudflare Pages)
#
# IMPORTANT SECURITY RULES:
# 1. Never put your Supabase service_role key here. Only use the public anon key.
# 2. Never commit .env or .env.production to version control.

VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key
